APP_NAME=SFMS Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=postgres

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required for registration email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=SFMS
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173

# Optional profile-image storage
MEDIA_ROOT=media
MEDIA_URL=/media
MAX_PROFILE_IMAGE_MB=5

# Keep true for first run; after `python -m app.utils.backfill_default_categories` completes,
# set false to avoid scanning every user on each development-server restart.
RUN_STARTUP_USER_BACKFILL=true

# Soft AI layer switch. false = AI routes unmounted; core finance still runs.
AI_ENABLED=true

# Optional AI-assisted transaction drafting; never expose this in Vite/client environment
# Select ONE free mode: groq, gemini or ollama (local).
AI_PROVIDER=groq
# Free-tier key from https://console.groq.com/keys; never put keys in frontend .env
AI_API_KEY=
# Leave blank to use Groq: openai/gpt-oss-120b, Gemini: gemini-3.5-flash-lite, Ollama: qwen3:4b
AI_MODEL=
# Used ONLY when AI_PROVIDER=ollama. Local access only for financial privacy.
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional second FREE provider, used only if the first hits its rate limit / is down.
# Example: primary groq + fallback gemini (key from https://aistudio.google.com/apikey)
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Set to true to ask Gemini to fill obviously omitted source entries if Groq response was incomplete.
AI_REVIEW_INCOMPLETE_PRIMARY=true
# Optional: one extra model request per import to polish only clarification wording, not question fields.
AI_REPHRASE_QUESTIONS=false
