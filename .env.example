# ============================================================
# SFMS Backend — Environment Variables
# Copy this file to .env and replace required values.
# NEVER commit the real .env file to Git.
# ============================================================

# ---- App ----
APP_NAME=SFMS Backend
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api

# ---- Database (Supabase PostgreSQL) ----
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_HOST=your_supabase_pooler_host
DB_PORT=5432
DB_NAME=postgres

# ---- JWT ----
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Security ----
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:8000

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_sender_email
SMTP_FROM_NAME=SFMS
SMTP_USE_TLS=true
SMTP_USE_SSL=false

PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173

# ---- Media ----
MEDIA_ROOT=media
MEDIA_URL=/media
MAX_PROFILE_IMAGE_MB=1

# ---- Startup Maintenance ----
RUN_STARTUP_USER_BACKFILL=true

# ---- AI Configuration ----
AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key
AI_MODEL=

# ---- Optional AI Fallback ----
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ---- AI Behavior ----
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AI_REVIEW_INCOMPLETE_PRIMARY=true
AI_REPHRASE_QUESTIONS=false